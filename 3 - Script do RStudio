install.packages("ape")
# ape is a package in R used to deal with phylogenetic data
library(ape)
# read the full phylogeny of Lupinus
tr<-read.nexus(file="lupintree.tre")
# you can plot the tree with plot just to check 
plot(tr)
# let s read the sample information used in this project
sampleInfo<-read.table("samplesLupinus_eoBMG25.txt",header=TRUE,sep="\t")
# and create a new tree with only the samples analysed (need to use the column species.name)
subtree<-keep.tip(tr,sampleInfo$species.name)

# check the full vs sub trees
# this creates 2 panels for plotss
par(mfrow=c(1,2))
plot(tr,cex=.5)
plot(subtree,cex=1)
# the following command gets the name of the species on the subtree, in the order that they appear on the tree (bottom to up)
tip_order <- subtree$tip.label[subtree$edge[subtree$edge[,2] <= length(subtree$tip.label), 2]]

# now we read the summarised results from repeatexplorer
repeatAnnot<-read.table("repeats.lupinus.txt",header=TRUE,sep="\t")
# check what this dataset contains now
str(repeatAnnot)


# the following 3 lines create a new object, repeats_summary, with just the information we need, and adds a row at the bottom that has the total number of reads of each sample  

totals<-cbind("total reads",NA,NA,repeatAnnot[1,10:ncol(repeatAnnot)])
names(totals)[1:3]<-c("Final_annotation","cluster","supercluster")
repeats_summary<-rbind(repeatAnnot[2:nrow(repeatAnnot),7:ncol(repeatAnnot)], totals)
str(repeats_summary)
# now we ned to normalise the number of reads, i.e. remove mitochondiral and plastid (if there's other contamination we need to check too) and then divide the number of reads of each repeat element by the total number of reads (for each sample)
repeats_summary_norm<-repeats_summary
# this next command gets the indexes of  the rows with mitochondrial and plastid reads - to be excluded in calculations
idxs_row_cont<-grep("mitochondria|plastid",repeats_summary$Final_annotation)

# now we loop over each individual and normalise the counts for its repeats
for(icol in 4:ncol(repeats_summary)){
  # total_species is the total number of reads in this species
  total_species = repeats_summary[nrow(repeats_summary),icol]
  # we obtain the total number of nuclear reads by subtracting mitochondiral and plastid reads
  total_species_nuclear<-total_species - sum(repeats_summary[idxs_row_cont,icol])
  # the next loop goes over each repeat type of this species, and divides it by the total number of nuclear reads
  # it finishes at nrow-1 because the last row is the total number of reads for the individual
  for(irow in 1:(nrow(repeats_summary)-1)){
    repeats_summary_norm[irow,icol]=100*repeats_summary[irow,icol]/total_species_nuclear
  }
}

# let s remove cols and rows not needed
repeats_final<-repeats_summary_norm[-c(idxs_row_cont,nrow(repeats_summary_norm)),4:ncol(repeats_summary_norm)]
# and keep only the most specific term for each repeat
rownames(repeats_final)<-basename(repeats_summary_norm[-c(idxs_row_cont,nrow(repeats_summary_norm)),1])

# Here we change the accession numbers for species names, so it matches the names in our phylogeny
# Note that for Lupinus there is a problem here with LUP in the repeatExplorer output and Lup in our codes, so first change everything to "Lup"
colnames(repeats_final)<-sub("LUP","Lup",colnames(repeats_final))
# also, in your runs the name of the sample was too long, it included the underscore at the end of the name. So let s remove it
colnames(repeats_final)<-sub("_","",colnames(repeats_final))


# now replace codes with species names
for(i in 1:dim(repeats_final)[2]){
  colnames(repeats_final)[i]<-sampleInfo$species.name[which(sampleInfo$Bioinf_code == colnames(repeats_final)[i])]
}

# Now order the data frame according to the species order in the phylogeny figure
repeats_final<-repeats_final[,tip_order]

# here we need to choose colours... bit hard with so many, but they are ordered so maybe this works?
cols<-rainbow(22)
barplot(1:22)

legenda <- c("Satelitte","45S_rDNA","5S_rDNA","Class_I",
             "LINE","LTR","Ty1/copia","SIRE","Angela","TAR",
             "Ale","Ivana","Tork","Ikeros","Tekay","Athila","CRM",
             "Galadriel","EnSpm_CACTA","MuDR_Mutator","Helitron","All")

legenda

par(mfrow=c(1,3))
plot(subtree,cex=1)
barplot(as.matrix(repeats_final),horiz=TRUE,las=1,col=cols, border="black")
legend(x=75,y=21.6,xpd=NA,fill=cols,leg = legenda,cex=1.4)
