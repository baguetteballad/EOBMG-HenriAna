# Then we created another loop to run the jellyfish command for every pair of samples, both counting the K-mers and creating the histograms. 
nano run_jellyfish.sh
#!/bin/bash
module load jellyfish/2.3.0
kmer=17
INPUTFOLDER="/home/eobmg25/rawdata/clean_reads_lup"
OUTPUTFOLDER="/home/eobmg25/rawdata/clean_reads_lup"
# Loop. 
for fq1 in $INPUTFOLDER/*.1_val_1.fq; do
    SAMPLE=$(basename "$fq1" .1_val_1.fq)
    fq2="$INPUTFOLDER/${SAMPLE}.2_val_2.fq"

    echo ">>> Processing sample: $SAMPLE"

    # K-mers count.
    jellyfish count -t 8 -C -m $kmer -s 5G \
        -o $OUTPUTFOLDER/${SAMPLE}.${kmer} \
        --min-qual-char='?' \
        $fq1 $fq2

    # Histogram creation.
    jellyfish histo -o $OUTPUTFOLDER/${SAMPLE}.${kmer}.histo \
        $OUTPUTFOLDER/${SAMPLE}.${kmer}

    echo "✔ Sample $SAMPLE concluded!"
done
Ctrl + O # Saves the file. 
Enter
Ctrl + X # Exits the editor.
