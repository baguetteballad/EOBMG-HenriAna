# We created a loop to decompress all pairs of samples terminating in "gz". "gunzip" decompresses these files, leaving us with $sample.fq.
nano gunzip_all.sh
#!/bin/bash
OUTPUTFOLDER="/home/eobmg25/rawdata/clean_reads_lup"
cd "$OUTPUTFOLDER" || exit
# Loop for all files *_1_val_1.fq.gz
for fq1 in *.1_val_1.fq.gz; do
    # Extract the prefix name/basename (without .1_val_1.fq.gz).
    SAMPLE=$(basename "$fq1" .1_val_1.fq.gz)
    
    fq2="${SAMPLE}.2_val_2.fq.gz"
    
    # Verify if the pair exists.
    if [[ -f "$fq2" ]]; then
        echo ">>> A descomprimir amostra: $SAMPLE"
        gunzip "$fq1"
        gunzip "$fq2"
        echo "$SAMPLE concluída!"
    else
        echo "Aviso: ficheiro par não encontrado para $SAMPLE"
    fi
done
